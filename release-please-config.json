{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "ruby",
      "package-name": "grift",
      "version-file": "lib/grift/version.rb",
      "include-component-in-tag": false,
      "pull-request-header": "Release grift with the version and changes below.",
      "pull-request-footer": "See [Releasing](https://github.com/clarkedb/grift#releasing) for what happens after merging.",
      "changelog-sections": [
        { "type": "feat", "section": "Added" },
        { "type": "fix", "section": "Fixed" },
        { "type": "perf", "section": "Fixed" }
      ]
    }
  }
}
